# Studio API URL for Expo (phone must reach your PC LAN IP)
EXPO_PUBLIC_STUDIO_API=http://192.168.x.x:8787

# Whisper prompt must be SAMPLE WORDS (style priming), never instructions —
# instructional prompts get echoed as fake transcript.
# OPENAI_ASR_LANGUAGE=auto
# OPENAI_ASR_CHUNK_SEC=30
# OPENAI_ASR_PROMPT=Salam 3likom, kif dayr, wach, 3lach, mzyan

# Super Editor — cloud ASR + LLM director
ASR_PROVIDER=openai
OPENAI_ASR_MODEL=whisper-1
DIRECTOR_PROVIDER=openai
DIRECTOR_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Optional local Whisper (dev only — not for Darija publish)
# ASR_PROVIDER=localWhisper
# WHISPER_MODEL=small
