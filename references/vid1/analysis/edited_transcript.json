{
  "language": "ar",
  "language_probability": 0.9553579092025757,
  "duration": 103.9775,
  "segments": [
    {
      "start": 0.0,
      "end": 3.76,
      "text": "خشيلة فرائي لا يفسد ليلو التقادية ويلا حي هل هي لي",
      "avg_logprob": -0.8033838823106554,
      "no_speech_prob": 0.47478240728378296
    },
    {
      "start": 3.76,
      "end": 8.7,
      "text": "و القادية لها دن اليوم هي خمس دي الناس في البسط القارسك واحد من النوه وفيه",
      "avg_logprob": -0.8033838823106554,
      "no_speech_prob": 0.47478240728378296
    },
    {
      "start": 8.7,
      "end": 12.26,
      "text": "يلول واحد درير افخش موندي بلومي الله سلا القرآن يديال",
      "avg_logprob": -0.8033838823106554,
      "no_speech_prob": 0.47478240728378296
    },
    {
      "start": 12.26,
      "end": 14.08,
      "text": "اخويا نأع ومونك القرآن",
      "avg_logprob": -0.8033838823106554,
      "no_speech_prob": 0.47478240728378296
    },
    {
      "start": 14.08,
      "end": 17.84,
      "text": "كيف اشن قدر انتقرآن دي ميليه افخو في سيونال واتس نكس",
      "avg_logprob": -0.8033838823106554,
      "no_speech_prob": 0.47478240728378296
    },
    {
      "start": 17.84,
      "end": 21.08,
      "text": "وحجو وشوية برشو بدا بعجم سيكون فواحد لستخسه",
      "avg_logprob": -0.8033838823106554,
      "no_speech_prob": 0.47478240728378296
    },
    {
      "start": 21.08,
      "end": 24.38,
      "text": "اتخسون تاني وحدي انسنسة القرآن يتوها دي آن",
      "avg_logprob": -0.8033838823106554,
      "no_speech_prob": 0.47478240728378296
    },
    {
      "start": 24.38,
      "end": 26.7,
      "text": "وعمو ونشو ماجمع اشتخدمة",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 26.7,
      "end": 30.78,
      "text": "انسك انتقرب لكم طالغيز وغلافا مي وبلغيز وصوصيو",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 30.78,
      "end": 34.44,
      "text": "تشوف درير سحابه اللي قروا معا ااخد مو در دي بخوجي",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 34.44,
      "end": 37.62,
      "text": "بشوف خدمة الابرة وهو بقمد ذا تشف حير",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 37.62,
      "end": 41.32,
      "text": "افق اخسون تشاو احد انسان اخداما عندها افضلها",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 41.32,
      "end": 43.0,
      "text": "ولكن شيء نصا تشف فيدي",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 43.0,
      "end": 45.56,
      "text": "ليم لا اجوف باني ادم إلا التوراب",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 45.56,
      "end": 46.46,
      "text": "اتشي عادي",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 46.46,
      "end": 48.5,
      "text": "لكن هي فلومو مؤكتوير كارا",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 48.5,
      "end": 51.38,
      "text": "محمل اشديك اخد مليفه ومكر هاتش",
      "avg_logprob": -0.8060674624972873,
      "no_speech_prob": 0.888407289981842
    },
    {
      "start": 51.38,
      "end": 53.86,
      "text": "شخد محسن ومندر ام بخوجي ديار",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 53.86,
      "end": 55.16,
      "text": "افق اخسون رابع",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 55.16,
      "end": 58.0,
      "text": "ادنا واحد درير مجامر اشوية روفيكس",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 58.0,
      "end": 60.54,
      "text": "كيقول كأخويا الله واند رب اثنين لخمسينين",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 60.54,
      "end": 63.68,
      "text": "راسي كم رب اخوجي دياري وخمر بحجاريين",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 63.68,
      "end": 66.16,
      "text": "وهمه الاونشي صالعي مخمش صالعي",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 66.16,
      "end": 68.76,
      "text": "ومأس يومي الكسترس دياري بقارب اثنين",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 68.76,
      "end": 71.82,
      "text": "خمسينين مكي لكسلت شاريين غير ضد فيديك صالعي",
      "avg_logprob": -0.63436775784856,
      "no_speech_prob": 0.5595531463623047
    },
    {
      "start": 71.82,
      "end": 75.24,
      "text": "لبخصول خامسهات نوحة السيدة اللي بخسك عنده خمسينين",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 75.24,
      "end": 76.52,
      "text": "تايف لن تخفق انا ريا",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 76.52,
      "end": 78.4,
      "text": "ولكن مع لغز مومانش هاتش",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 78.4,
      "end": 81.32,
      "text": "اتخب زبت للزيسيقل سيده ومعرى صعوك اجهول",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 81.32,
      "end": 83.56,
      "text": "وشنعا ومزيد انجره مرة رخرة",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 83.56,
      "end": 85.96,
      "text": "واللوظام اخسطين ناخشي ديسيزيون",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 85.96,
      "end": 88.3,
      "text": "ديسيزي في التاريات في خوفيسينون الدياري",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 88.3,
      "end": 89.88,
      "text": "ونبتلا دي ركسيه",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 89.88,
      "end": 91.56,
      "text": "وهد خمسة دن اثنى درنااليه",
      "avg_logprob": -0.9109447082596509,
      "no_speech_prob": 0.4785138666629791
    },
    {
      "start": 91.56,
      "end": 94.66,
      "text": "كمليك ايشو استخس ركولة واحده في البسة ديار",
      "avg_logprob": -0.9675192770858606,
      "no_speech_prob": 0.5091435313224792
    },
    {
      "start": 94.66,
      "end": 97.54,
      "text": "هجو احد اللي بغيت كامر هم اتخرش لك مرسك",
      "avg_logprob": -0.9675192770858606,
      "no_speech_prob": 0.5091435313224792
    },
    {
      "start": 97.54,
      "end": 100.0,
      "text": "لهي يا سكسس andها بيناس",
      "avg_logprob": -0.9675192770858606,
      "no_speech_prob": 0.5091435313224792
    },
    {
      "start": 100.0,
      "end": 101.42,
      "text": "لا تتخذ كل شيء",
      "avg_logprob": -0.9675192770858606,
      "no_speech_prob": 0.5091435313224792
    },
    {
      "start": 102.3,
      "end": 102.86,
      "text": "اوكي",
      "avg_logprob": -0.9675192770858606,
      "no_speech_prob": 0.5091435313224792
    },
    {
      "start": 102.86,
      "end": 103.86,
      "text": "لا اعوه",
      "avg_logprob": -0.9675192770858606,
      "no_speech_prob": 0.5091435313224792
    }
  ],
